#: data/io.github.nautilus_7zip.Nautilus7Zip.desktop.in:2
#: src/nautilus_7zip/application.py:413
msgid "7-Zip for Nautilus"
msgstr "7-Zip для Nautilus"

#: data/io.github.nautilus_7zip.Nautilus7Zip.desktop.in:3
msgid "Create and extract archives with 7-Zip"
msgstr "Создание и распаковка архивов с помощью 7-Zip"

#: src/extension/nautilus_7zip.py:34
msgid "Create archive…"
msgstr "Создать архив…"

#: src/extension/nautilus_7zip.py:38
#, python-brace-format
msgid "Create {name}.7z"
msgstr "Создать {name}.7z"

#: src/extension/nautilus_7zip.py:44
#, python-brace-format
msgid "Create {name}.zip"
msgstr "Создать {name}.zip"

#: src/extension/nautilus_7zip.py:50
msgid "Extract…"
msgstr "Распаковать…"

#: src/extension/nautilus_7zip.py:51
msgid "Extract here"
msgstr "Распаковать здесь"

#: src/extension/nautilus_7zip.py:55
#, python-brace-format
msgid "Extract to {name}/"
msgstr "Распаковать в {name}/"

#: src/extension/nautilus_7zip.py:58
msgid "Test archive"
msgstr "Проверить архив"

#: src/extension/nautilus_7zip.py:62
msgid "7-Zip"
msgstr "7-Zip"

#: src/nautilus_7zip/application.py:57
msgid "Extraction and testing require one archive."
msgstr "Для распаковки или проверки выберите один архив."

#: src/nautilus_7zip/application.py:116
msgid "Browse…"
msgstr "Обзор…"

#: src/nautilus_7zip/application.py:124
msgid "Select a folder"
msgstr "Выберите папку"

#: src/nautilus_7zip/application.py:145
msgid "Unable to start operation"
msgstr "Не удалось запустить операцию"

#: src/nautilus_7zip/application.py:146 src/nautilus_7zip/application.py:323
#: src/nautilus_7zip/application.py:424
msgid "Close"
msgstr "Закрыть"

#: src/nautilus_7zip/application.py:157 src/nautilus_7zip/application.py:197
msgid "Create archive"
msgstr "Создать архив"

#: src/nautilus_7zip/application.py:161 src/nautilus_7zip/application.py:258
msgid "Destination"
msgstr "Папка назначения"

#: src/nautilus_7zip/application.py:163
msgid "Archive name"
msgstr "Имя архива"

#: src/nautilus_7zip/application.py:170
msgid "Format"
msgstr "Формат"

#: src/nautilus_7zip/application.py:174
msgid "Store (no compression)"
msgstr "Без сжатия"

#: src/nautilus_7zip/application.py:175
msgid "Fastest"
msgstr "Самое быстрое"

#: src/nautilus_7zip/application.py:176
msgid "Fast"
msgstr "Быстрое"

#: src/nautilus_7zip/application.py:177
msgid "Normal"
msgstr "Обычное"

#: src/nautilus_7zip/application.py:178
msgid "Maximum"
msgstr "Максимальное"

#: src/nautilus_7zip/application.py:179
msgid "Ultra"
msgstr "Ультра"

#: src/nautilus_7zip/application.py:183
msgid "Compression level"
msgstr "Уровень сжатия"

#: src/nautilus_7zip/application.py:186
msgid "Password (optional)"
msgstr "Пароль (необязательно)"

#: src/nautilus_7zip/application.py:189
msgid "Solid archive"
msgstr "Непрерывный архив"

#: src/nautilus_7zip/application.py:190
msgid "Encrypt file names"
msgstr "Шифровать имена файлов"

#: src/nautilus_7zip/application.py:191
msgid "Test archive after creation"
msgstr "Проверить архив после создания"

#: src/nautilus_7zip/application.py:195
msgid "Options"
msgstr "Параметры"

#: src/nautilus_7zip/application.py:213
msgid "Archive name must not be empty."
msgstr "Имя архива не может быть пустым."

#: src/nautilus_7zip/application.py:216
msgid "Destination folder does not exist."
msgstr "Папка назначения не существует."

#: src/nautilus_7zip/application.py:223
msgid "A password is required to encrypt file names."
msgstr "Для шифрования имён файлов требуется пароль."

#: src/nautilus_7zip/application.py:253
msgid "Extract archive"
msgstr "Распаковать архив"

#: src/nautilus_7zip/application.py:260
msgid "Password (if required)"
msgstr "Пароль (если требуется)"

#: src/nautilus_7zip/application.py:263
msgid "Rename extracted files"
msgstr "Переименовывать распакованные файлы"

#: src/nautilus_7zip/application.py:264
msgid "Overwrite existing files"
msgstr "Перезаписывать существующие файлы"

#: src/nautilus_7zip/application.py:265
msgid "Skip existing files"
msgstr "Пропускать существующие файлы"

#: src/nautilus_7zip/application.py:267
msgid "If a file already exists"
msgstr "Если файл уже существует"

#: src/nautilus_7zip/application.py:269
msgid "Extract"
msgstr "Распаковать"

#: src/nautilus_7zip/application.py:278
msgid "The parent of the destination folder does not exist."
msgstr "Родительская папка для каталога назначения не существует."

#: src/nautilus_7zip/application.py:295
msgid "7-Zip operation"
msgstr "Операция 7-Zip"

#: src/nautilus_7zip/application.py:321
msgid "Cancel"
msgstr "Отмена"

#: src/nautilus_7zip/application.py:337
msgid "Operation completed successfully"
msgstr "Операция успешно завершена"

#: src/nautilus_7zip/application.py:372
msgid "Operation cancelled"
msgstr "Операция отменена"

#: src/nautilus_7zip/application.py:374
#, python-brace-format
msgid "7-Zip exited with status {status}."
msgstr "7-Zip завершился с кодом {status}."

#: src/nautilus_7zip/application.py:377
msgid "Operation failed"
msgstr "Операция завершилась с ошибкой"

#: src/nautilus_7zip/application.py:385
msgid "Cancelling…"
msgstr "Отмена…"

msgstr "Имя архива не может быть пустым."

#: src/nautilus_7zip/application.py:226
msgid "Destination folder does not exist."
msgstr "Папка назначения не существует."

#: src/nautilus_7zip/application.py:233
msgid "A password is required to encrypt file names."
msgstr "Для шифрования имён файлов требуется пароль."

#: src/nautilus_7zip/application.py:262
msgid "Extract archive"
msgstr "Распаковать архив"


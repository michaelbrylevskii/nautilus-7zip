msgid "Store (no compression)"
msgstr "Без сжатия"

#: src/nautilus_7zip/application.py:185
msgid "Fastest"
msgstr "Самое быстрое"

#: src/nautilus_7zip/application.py:186
msgid "Fast"
msgstr "Быстрое"

#: src/nautilus_7zip/application.py:187
msgid "Normal"
msgstr "Обычное"

#: src/nautilus_7zip/application.py:188
msgid "Maximum"
msgstr "Максимальное"

#: src/nautilus_7zip/application.py:189
msgid "Ultra"
msgstr "Ультра"


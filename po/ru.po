#: data/io.github.nautilus_7zip.Nautilus7Zip.desktop.in:2
#: src/nautilus_7zip/application.py:901
msgid "7-Zip for Nautilus"
msgstr "7-Zip для Nautilus"

#: data/io.github.nautilus_7zip.Nautilus7Zip.desktop.in:3
msgid "Create and extract archives with 7-Zip"
msgstr "Создание и распаковка архивов с помощью 7-Zip"

#: src/extension/nautilus_7zip_extension.py:39
msgid "Create archive…"
msgstr "Создать архив…"

#: src/extension/nautilus_7zip_extension.py:43
#, python-brace-format
msgid "Create {name}.7z"
msgstr "Создать {name}.7z"

#: src/extension/nautilus_7zip_extension.py:49
#, python-brace-format
msgid "Create {name}.zip"
msgstr "Создать {name}.zip"

#: src/extension/nautilus_7zip_extension.py:55
msgid "Extract…"
msgstr "Распаковать…"

#: src/extension/nautilus_7zip_extension.py:56
msgid "Extract here"
msgstr "Распаковать здесь"

#: src/extension/nautilus_7zip_extension.py:60
#, python-brace-format
msgid "Extract to {name}/"
msgstr "Распаковать в {name}/"

#: src/extension/nautilus_7zip_extension.py:63
msgid "Test archive"
msgstr "Проверить архив"

#: src/extension/nautilus_7zip_extension.py:67
msgid "7-Zip"
msgstr "7-Zip"

#: src/nautilus_7zip/application.py:100
msgid "Extraction and testing require one archive."
msgstr "Для распаковки или проверки выберите один архив."

#: src/nautilus_7zip/application.py:146 src/nautilus_7zip/application.py:427
#: src/nautilus_7zip/application.py:661
msgid "Cancel"
msgstr "Отмена"

#: src/nautilus_7zip/application.py:171
msgid "Choose a folder"
msgstr "Выбрать папку"

#: src/nautilus_7zip/application.py:180
msgid "Select a folder"
msgstr "Выберите папку"

#: src/nautilus_7zip/application.py:201
msgid "Unable to start operation"
msgstr "Не удалось запустить операцию"

#: src/nautilus_7zip/application.py:202 src/nautilus_7zip/application.py:664
#: src/nautilus_7zip/application.py:912
msgid "Close"
msgstr "Закрыть"

#: src/nautilus_7zip/application.py:223
msgid "Create Archive"
msgstr "Создать архив"

#: src/nautilus_7zip/application.py:227
msgid "Archive"
msgstr "Архив"

#: src/nautilus_7zip/application.py:229
msgid "Archive name"
msgstr "Имя архива"

#: src/nautilus_7zip/application.py:233 src/nautilus_7zip/application.py:600
msgid "Destination"
msgstr "Папка назначения"

#: src/nautilus_7zip/application.py:235
msgid "Format"
msgstr "Формат"

#: src/nautilus_7zip/application.py:237
msgid "High compression; may require 7-Zip on other systems."
msgstr "Высокая степень сжатия; на других системах может потребоваться 7-Zip."

#: src/nautilus_7zip/application.py:240
msgid "Widely compatible; AES-256 encryption may require 7-Zip."
msgstr "Широкая совместимость; для шифрования AES-256 может потребоваться 7-Zip."

#: src/nautilus_7zip/application.py:246
msgid "Compression level"
msgstr "Уровень сжатия"

#: src/nautilus_7zip/application.py:248
msgid "Store (no compression)"
msgstr "Без сжатия"

#: src/nautilus_7zip/application.py:249
msgid "Fastest"
msgstr "Самое быстрое"

#: src/nautilus_7zip/application.py:250
msgid "Fast"
msgstr "Быстрое"

#: src/nautilus_7zip/application.py:251
msgid "Normal"
msgstr "Обычное"

#: src/nautilus_7zip/application.py:252
msgid "Maximum"
msgstr "Максимальное"

#: src/nautilus_7zip/application.py:253
msgid "Ultra"
msgstr "Ультра"

#: src/nautilus_7zip/application.py:263
msgid "Encryption"
msgstr "Шифрование"

#: src/nautilus_7zip/application.py:265
msgid "Password protection"
msgstr "Защита паролем"

#: src/nautilus_7zip/application.py:266 src/nautilus_7zip/application.py:531
msgid "Encrypts archive contents with AES-256."
msgstr "Шифрует содержимое архива с помощью AES-256."

#: src/nautilus_7zip/application.py:272
msgid "Password"
msgstr "Пароль"

#: src/nautilus_7zip/application.py:276
msgid "Confirm password"
msgstr "Подтвердите пароль"

#: src/nautilus_7zip/application.py:280
msgid "Encrypt file names"
msgstr "Шифровать имена файлов"

#: src/nautilus_7zip/application.py:281
msgid "Hides file names until the password is entered."
msgstr "Скрывает имена файлов до ввода пароля."

#: src/nautilus_7zip/application.py:289
msgid "Options"
msgstr "Параметры"

#: src/nautilus_7zip/application.py:291
msgid "Verify after creation"
msgstr "Проверить после создания"

#: src/nautilus_7zip/application.py:292
msgid "Tests archive integrity when compression finishes."
msgstr "Проверяет целостность архива после завершения сжатия."

#: src/nautilus_7zip/application.py:295
msgid "Advanced Options"
msgstr "Расширенные параметры"

#: src/nautilus_7zip/application.py:298
msgid "CPU threads"
msgstr "Потоки CPU"

#: src/nautilus_7zip/application.py:300
#, python-brace-format
msgid "Auto ({count})"
msgstr "Автоматически ({count})"

#: src/nautilus_7zip/application.py:303
msgid "Limits CPU usage. Auto uses available processors."
msgstr ""
"Ограничивает нагрузку на CPU. Автоматический режим использует доступные "
"потоки."

#: src/nautilus_7zip/application.py:306
msgid "Solid block"
msgstr "Непрерывный блок"

#: src/nautilus_7zip/application.py:308
msgid "Auto — Recommended"
msgstr "Автоматически — рекомендуется"

#: src/nautilus_7zip/application.py:309
msgid "Non-solid"
msgstr "Без непрерывного сжатия"

#: src/nautilus_7zip/application.py:313
msgid "Fully solid"
msgstr "Полностью непрерывный"

#: src/nautilus_7zip/application.py:316
msgid ""
"Larger blocks can compress better but make individual files slower to "
"extract."
msgstr ""
"Большие блоки могут улучшить сжатие, но замедляют извлечение отдельных "
"файлов."

#: src/nautilus_7zip/application.py:320
msgid "Split into volumes"
msgstr "Разбить на тома"

#: src/nautilus_7zip/application.py:322
msgid "None — Single archive"
msgstr "Нет — один архив"

#: src/nautilus_7zip/application.py:326
msgid "4095 MiB — FAT32 compatible"
msgstr "4095 MiB — совместимо с FAT32"

#: src/nautilus_7zip/application.py:327
msgid "Custom…"
msgstr "Другой размер…"

#: src/nautilus_7zip/application.py:329 src/nautilus_7zip/application.py:389
msgid "Creates numbered .001, .002… files of the selected size."
msgstr "Создаёт нумерованные файлы .001, .002… выбранного размера."

#: src/nautilus_7zip/application.py:334
msgid "Edit custom volume size"
msgstr "Изменить размер тома"

#: src/nautilus_7zip/application.py:353
msgid "Create"
msgstr "Создать"

#: src/nautilus_7zip/application.py:380 src/nautilus_7zip/application.py:472
#, python-brace-format
msgid "Custom size: {size} per volume."
msgstr "Размер каждого тома: {size}."

#: src/nautilus_7zip/application.py:400
msgid "Custom Volume Size"
msgstr "Пользовательский размер тома"

#: src/nautilus_7zip/application.py:401
msgid "Choose the maximum size of each numbered archive volume."
msgstr "Выберите максимальный размер каждого нумерованного тома архива."

#: src/nautilus_7zip/application.py:405
msgid "Size"
msgstr "Размер"

#: src/nautilus_7zip/application.py:417
msgid "Unit"
msgstr "Единица измерения"

#: src/nautilus_7zip/application.py:428
msgid "Apply"
msgstr "Применить"

#: src/nautilus_7zip/application.py:507
msgid "Auto threads"
msgstr "Потоки автоматически"

#: src/nautilus_7zip/application.py:509
msgid "Custom threads"
msgstr "Потоки настроены"

#: src/nautilus_7zip/application.py:513
msgid "Auto solid block"
msgstr "Непрерывный блок автоматически"

#: src/nautilus_7zip/application.py:515
msgid "Custom solid block"
msgstr "Непрерывный блок настроен"

#: src/nautilus_7zip/application.py:517
msgid "Single archive"
msgstr "Один архив"

#: src/nautilus_7zip/application.py:517
msgid "Split archive"
msgstr "Многотомный архив"

#: src/nautilus_7zip/application.py:527 src/nautilus_7zip/application.py:553
msgid "Passwords do not match."
msgstr "Пароли не совпадают."

#: src/nautilus_7zip/application.py:529
msgid "Enter a password to encrypt file names."
msgstr "Введите пароль, чтобы зашифровать имена файлов."

#: src/nautilus_7zip/application.py:543
msgid "Archive name must not be empty."
msgstr "Имя архива не может быть пустым."

#: src/nautilus_7zip/application.py:546
msgid "Destination folder does not exist."
msgstr "Папка назначения не существует."

#: src/nautilus_7zip/application.py:558
msgid "A password is required to encrypt file names."
msgstr "Для шифрования имён файлов требуется пароль."

#: src/nautilus_7zip/application.py:578
msgid "An archive with this name already exists."
msgstr "Архив с таким именем уже существует."

#: src/nautilus_7zip/application.py:594
msgid "Extract Archive"
msgstr "Распаковать архив"

#: src/nautilus_7zip/application.py:599
msgid "Extraction"
msgstr "Распаковка"

#: src/nautilus_7zip/application.py:602
msgid "Password (if required)"
msgstr "Пароль (если требуется)"

#: src/nautilus_7zip/application.py:606
msgid "If a file already exists"
msgstr "Если файл уже существует"

#: src/nautilus_7zip/application.py:608
msgid "Rename extracted files"
msgstr "Переименовывать распакованные файлы"

#: src/nautilus_7zip/application.py:609
msgid "Overwrite existing files"
msgstr "Перезаписывать существующие файлы"

#: src/nautilus_7zip/application.py:610
msgid "Skip existing files"
msgstr "Пропускать существующие файлы"

#: src/nautilus_7zip/application.py:617
msgid "Extract"
msgstr "Распаковать"

#: src/nautilus_7zip/application.py:623
msgid "The parent of the destination folder does not exist."
msgstr "Родительская папка для каталога назначения не существует."

#: src/nautilus_7zip/application.py:639 src/nautilus_7zip/application.py:660
msgid "7-Zip operation"
msgstr "Операция 7-Zip"

#: src/nautilus_7zip/application.py:693
msgid "Details"
msgstr "Подробности"

#: src/nautilus_7zip/application.py:711
msgid "Operation completed successfully"
msgstr "Операция успешно завершена"

#: src/nautilus_7zip/application.py:760
#, python-brace-format
msgid "Elapsed {duration}"
msgstr "Прошло: {duration}"

#: src/nautilus_7zip/application.py:766
#, python-brace-format
msgid "Step {current}/{total}"
msgstr "Шаг {current}/{total}"

#: src/nautilus_7zip/application.py:774
#, python-brace-format
msgid "Items {current}/{total}"
msgstr "Элементы: {current}/{total}"

#: src/nautilus_7zip/application.py:781
#, python-brace-format
msgid "Items processed: {count}"
msgstr "Обработано элементов: {count}"

#: src/nautilus_7zip/application.py:787
#, python-brace-format
msgid "About {duration} remaining"
msgstr "Осталось примерно {duration}"

#: src/nautilus_7zip/application.py:800
msgid "Operation cancelled"
msgstr "Операция отменена"

#: src/nautilus_7zip/application.py:802
#, python-brace-format
msgid "7-Zip exited with status {status}."
msgstr "7-Zip завершился с кодом {status}."

#: src/nautilus_7zip/application.py:805
msgid "Operation failed"
msgstr "Операция завершилась с ошибкой"

#: src/nautilus_7zip/application.py:814
msgid "Cancelling…"
msgstr "Отмена…"

#~ msgid "Compatible with most operating systems."
#~ msgstr "Совместимо с большинством операционных систем."

#~ msgid "Use an integer followed by M or G, for example 1500M or 4G."
#~ msgstr "Введите целое число с M или G, например 1500M или 4G."

#~ msgid "Enter a valid volume size, for example 1500M or 4G."
#~ msgstr "Введите допустимый размер тома, например 1500M или 4G."

#~ msgid "Browse…"
#~ msgstr "Обзор…"

#: data/io.github.nautilus_7zip.Nautilus7Zip.desktop.in:2
#: src/nautilus_7zip/application.py:930
msgid "7-Zip for Nautilus"
msgstr "7-Zip для Nautilus"

#: data/io.github.nautilus_7zip.Nautilus7Zip.desktop.in:3
msgid "Create and extract archives with 7-Zip"
msgstr "Создание и распаковка архивов с помощью 7-Zip"

#: src/extension/nautilus_7zip_extension.py:39
msgid "Create archive…"
msgstr "Создать архив…"

#: src/extension/nautilus_7zip_extension.py:43
#, python-brace-format
msgid "Create {name}.7z"
msgstr "Создать {name}.7z"

#: src/extension/nautilus_7zip_extension.py:49
#, python-brace-format
msgid "Create {name}.zip"
msgstr "Создать {name}.zip"

#: src/extension/nautilus_7zip_extension.py:55
msgid "Extract…"
msgstr "Распаковать…"

#: src/extension/nautilus_7zip_extension.py:56
msgid "Extract here"
msgstr "Распаковать здесь"

#: src/extension/nautilus_7zip_extension.py:60
#, python-brace-format
msgid "Extract to {name}/"
msgstr "Распаковать в {name}/"

#: src/extension/nautilus_7zip_extension.py:63
msgid "Test archive"
msgstr "Проверить архив"

#: src/extension/nautilus_7zip_extension.py:67
msgid "7-Zip"
msgstr "7-Zip"

#: src/nautilus_7zip/application.py:102
msgid "Extraction and testing require one archive."
msgstr "Для распаковки или проверки выберите один архив."

#: src/nautilus_7zip/application.py:148 src/nautilus_7zip/application.py:434
#: src/nautilus_7zip/application.py:667
msgid "Cancel"
msgstr "Отмена"

#: src/nautilus_7zip/application.py:173
msgid "Choose a folder"
msgstr "Выбрать папку"

#: src/nautilus_7zip/application.py:182
msgid "Select a folder"
msgstr "Выберите папку"

#: src/nautilus_7zip/application.py:203
msgid "Unable to start operation"
msgstr "Не удалось запустить операцию"

#: src/nautilus_7zip/application.py:204 src/nautilus_7zip/application.py:670
#: src/nautilus_7zip/application.py:941
msgid "Close"
msgstr "Закрыть"

#: src/nautilus_7zip/application.py:225
msgid "Create Archive"
msgstr "Создать архив"

#: src/nautilus_7zip/application.py:229
msgid "Archive"
msgstr "Архив"

#: src/nautilus_7zip/application.py:231
msgid "Archive name"
msgstr "Имя архива"

#: src/nautilus_7zip/application.py:235 src/nautilus_7zip/application.py:606
msgid "Destination"
msgstr "Папка назначения"

#: src/nautilus_7zip/application.py:237
msgid "Format"
msgstr "Формат"

#: src/nautilus_7zip/application.py:239
msgid "High compression; may require 7-Zip on other systems."
msgstr "Высокая степень сжатия; на других системах может потребоваться 7-Zip."

#: src/nautilus_7zip/application.py:242
msgid "Widely compatible; AES-256 encryption may require 7-Zip."
msgstr ""
"Широкая совместимость; для шифрования AES-256 может потребоваться 7-Zip."

#: src/nautilus_7zip/application.py:248
msgid "Compression level"
msgstr "Уровень сжатия"

#: src/nautilus_7zip/application.py:250
msgid "Store (no compression)"
msgstr "Без сжатия"

#: src/nautilus_7zip/application.py:251
msgid "Fastest"
msgstr "Самое быстрое"

#: src/nautilus_7zip/application.py:252
msgid "Fast"
msgstr "Быстрое"

#: src/nautilus_7zip/application.py:253
msgid "Normal"
msgstr "Обычное"

#: src/nautilus_7zip/application.py:254
msgid "Maximum"
msgstr "Максимальное"

#: src/nautilus_7zip/application.py:255
msgid "Ultra"
msgstr "Ультра"

#: src/nautilus_7zip/application.py:265
msgid "Encryption"
msgstr "Шифрование"

#: src/nautilus_7zip/application.py:267
msgid "Password protection"
msgstr "Защита паролем"

#: src/nautilus_7zip/application.py:268 src/nautilus_7zip/application.py:537
msgid "Encrypts archive contents with AES-256."
msgstr "Шифрует содержимое архива с помощью AES-256."

#: src/nautilus_7zip/application.py:274
msgid "Password"
msgstr "Пароль"

#: src/nautilus_7zip/application.py:278
msgid "Confirm password"
msgstr "Подтвердите пароль"

#: src/nautilus_7zip/application.py:282
msgid "Encrypt file names"
msgstr "Шифровать имена файлов"

#: src/nautilus_7zip/application.py:283
msgid "Hides file names until the password is entered."
msgstr "Скрывает имена файлов до ввода пароля."

#: src/nautilus_7zip/application.py:291
msgid "Options"
msgstr "Параметры"

#: src/nautilus_7zip/application.py:293
msgid "Verify after creation"
msgstr "Проверить после создания"

#: src/nautilus_7zip/application.py:294
msgid "Tests archive integrity when compression finishes."
msgstr "Проверяет целостность архива после завершения сжатия."

#: src/nautilus_7zip/application.py:297
msgid "Advanced Options"
msgstr "Расширенные параметры"

#: src/nautilus_7zip/application.py:300
msgid "CPU threads"
msgstr "Потоки CPU"

#: src/nautilus_7zip/application.py:302
#, python-brace-format
msgid "Auto ({count})"
msgstr "Автоматически ({count})"

#: src/nautilus_7zip/application.py:305
msgid "Limits CPU usage. Auto uses available processors."
msgstr ""
"Ограничивает нагрузку на CPU. Автоматический режим использует доступные "
"потоки."

#: src/nautilus_7zip/application.py:308
msgid "Solid block"
msgstr "Непрерывный блок"

#: src/nautilus_7zip/application.py:310
msgid "Auto"
msgstr "Авто"

#: src/nautilus_7zip/application.py:310
msgid "Recommended"
msgstr "Рекомендуется"

#: src/nautilus_7zip/application.py:311
msgid "Non-solid"
msgstr "Без непрерывного сжатия"

#: src/nautilus_7zip/application.py:311
msgid "Independent extraction"
msgstr "Независимое извлечение"

#: src/nautilus_7zip/application.py:315
msgid "Fully solid"
msgstr "Полностью непрерывный"

#: src/nautilus_7zip/application.py:315
msgid "One block"
msgstr "Один блок"

#: src/nautilus_7zip/application.py:320
msgid "Controls how much data is grouped into each solid block."
msgstr "Определяет объём данных, объединяемых в один сплошной блок."

#: src/nautilus_7zip/application.py:323 src/nautilus_7zip/application.py:334
msgid "None"
msgstr "Нет"

#: src/nautilus_7zip/application.py:329 src/nautilus_7zip/application.py:340
#: src/nautilus_7zip/application.py:349
msgid "Custom…"
msgstr "Другой размер…"

#: src/nautilus_7zip/application.py:332
msgid "Split into volumes"
msgstr "Разбить на тома"

#: src/nautilus_7zip/application.py:334 src/nautilus_7zip/application.py:343
msgid "Single archive"
msgstr "Один архив"

#: src/nautilus_7zip/application.py:339
msgid "Custom value"
msgstr "Пользовательский"

#: src/nautilus_7zip/application.py:340
msgid "Choose size"
msgstr "Выбрать размер"

#: src/nautilus_7zip/application.py:355
msgid "Controls archive splitting and the maximum size of each volume."
msgstr "Определяет разбиение архива и максимальный размер каждого тома."

#: src/nautilus_7zip/application.py:370
msgid "Create"
msgstr "Создать"

#: src/nautilus_7zip/application.py:406
msgid "Custom Volume Size"
msgstr "Пользовательский размер тома"

#: src/nautilus_7zip/application.py:428
msgid "Volume size"
msgstr "Размер тома"

#: src/nautilus_7zip/application.py:435
msgid "Apply"
msgstr "Применить"

#: src/nautilus_7zip/application.py:515
#, python-brace-format
msgid "Threads: {value}"
msgstr "Потоки: {value}"

#: src/nautilus_7zip/application.py:519
#, python-brace-format
msgid "Solid: {value}"
msgstr "Сплошной блок: {value}"

#: src/nautilus_7zip/application.py:522
#, python-brace-format
msgid "Volumes: {value}"
msgstr "Тома: {value}"

#: src/nautilus_7zip/application.py:533 src/nautilus_7zip/application.py:559
msgid "Passwords do not match."
msgstr "Пароли не совпадают."

#: src/nautilus_7zip/application.py:535
msgid "Enter a password to encrypt file names."
msgstr "Введите пароль, чтобы зашифровать имена файлов."

#: src/nautilus_7zip/application.py:549
msgid "Archive name must not be empty."
msgstr "Имя архива не может быть пустым."

#: src/nautilus_7zip/application.py:552
msgid "Destination folder does not exist."
msgstr "Папка назначения не существует."

#: src/nautilus_7zip/application.py:564
msgid "A password is required to encrypt file names."
msgstr "Для шифрования имён файлов требуется пароль."

#: src/nautilus_7zip/application.py:584
msgid "An archive with this name already exists."
msgstr "Архив с таким именем уже существует."

#: src/nautilus_7zip/application.py:600
msgid "Extract Archive"
msgstr "Распаковать архив"

#: src/nautilus_7zip/application.py:605
msgid "Extraction"
msgstr "Распаковка"

#: src/nautilus_7zip/application.py:608
msgid "Password (if required)"
msgstr "Пароль (если требуется)"

#: src/nautilus_7zip/application.py:612
msgid "If a file already exists"
msgstr "Если файл уже существует"

#: src/nautilus_7zip/application.py:614
msgid "Rename extracted files"
msgstr "Переименовывать распакованные файлы"

#: src/nautilus_7zip/application.py:615
msgid "Overwrite existing files"
msgstr "Перезаписывать существующие файлы"

#: src/nautilus_7zip/application.py:616
msgid "Skip existing files"
msgstr "Пропускать существующие файлы"

#: src/nautilus_7zip/application.py:623
msgid "Extract"
msgstr "Распаковать"

#: src/nautilus_7zip/application.py:629
msgid "The parent of the destination folder does not exist."
msgstr "Родительская папка для каталога назначения не существует."

#: src/nautilus_7zip/application.py:645 src/nautilus_7zip/application.py:666
msgid "7-Zip operation"
msgstr "Операция 7-Zip"

#: src/nautilus_7zip/application.py:699
msgid "Details"
msgstr "Подробности"

#: src/nautilus_7zip/application.py:717
msgid "Operation completed successfully"
msgstr "Операция успешно завершена"

#: src/nautilus_7zip/application.py:766
#, python-brace-format
msgid "Elapsed {duration}"
msgstr "Прошло: {duration}"

#: src/nautilus_7zip/application.py:772
#, python-brace-format
msgid "Step {current}/{total}"
msgstr "Шаг {current}/{total}"

#: src/nautilus_7zip/application.py:780
#, python-brace-format
msgid "Items {current}/{total}"
msgstr "Элементы: {current}/{total}"

#: src/nautilus_7zip/application.py:787
#, python-brace-format
msgid "Items processed: {count}"
msgstr "Обработано элементов: {count}"

#: src/nautilus_7zip/application.py:793
#, python-brace-format
msgid "About {duration} remaining"
msgstr "Осталось примерно {duration}"

#: src/nautilus_7zip/application.py:806
msgid "Operation cancelled"
msgstr "Операция отменена"

#: src/nautilus_7zip/application.py:808
#, python-brace-format
msgid "7-Zip exited with status {status}."
msgstr "7-Zip завершился с кодом {status}."

#: src/nautilus_7zip/application.py:811
msgid "Operation failed"
msgstr "Операция завершилась с ошибкой"

#: src/nautilus_7zip/application.py:820
msgid "Cancelling…"
msgstr "Отмена…"


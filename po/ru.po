#: src/nautilus_7zip/application.py:455
msgid "Create"
msgstr "Создать"

#: src/nautilus_7zip/application.py:491
msgid "Custom Volume Size"
msgstr "Пользовательский размер тома"

#: src/nautilus_7zip/application.py:513
msgid "Volume size"
msgstr "Размер тома"

#: src/nautilus_7zip/application.py:520
msgid "Apply"
msgstr "Применить"

#: src/nautilus_7zip/application.py:604
#, python-brace-format
msgid "Threads: {value}"
msgstr "Потоки: {value}"

#: src/nautilus_7zip/application.py:608
#, python-brace-format
msgid "Solid: {value}"
msgstr "Сплошной блок: {value}"

#: src/nautilus_7zip/application.py:611
#, python-brace-format
msgid "Volumes: {value}"
msgstr "Тома: {value}"

#: src/nautilus_7zip/application.py:622 src/nautilus_7zip/application.py:648
msgid "Passwords do not match."

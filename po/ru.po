msgid "Extract"
msgstr "Распаковать"

#: src/nautilus_7zip/application.py:287
msgid "The parent of the destination folder does not exist."
msgstr "Родительская папка для каталога назначения не существует."

#: src/nautilus_7zip/application.py:303
msgid "7-Zip operation"
msgstr "Операция 7-Zip"

#: src/nautilus_7zip/application.py:331
msgid "Details"
msgstr "Подробности"

#: src/nautilus_7zip/application.py:339
msgid "Cancel"
msgstr "Отмена"

#: src/nautilus_7zip/application.py:355
msgid "Operation completed successfully"
msgstr "Операция успешно завершена"

#: src/nautilus_7zip/application.py:390
msgid "Operation cancelled"
msgstr "Операция отменена"

#: src/nautilus_7zip/application.py:392
#, python-brace-format
msgid "7-Zip exited with status {status}."
msgstr "7-Zip завершился с кодом {status}."

#: src/nautilus_7zip/application.py:395
msgid "Operation failed"
msgstr "Операция завершилась с ошибкой"

#: src/nautilus_7zip/application.py:404
msgid "Cancelling…"
msgstr "Отмена…"

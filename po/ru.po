msgid "Destination"
msgstr "Папка назначения"

#: src/nautilus_7zip/application.py:316
msgid "Format"
msgstr "Формат"

#: src/nautilus_7zip/application.py:318
msgid "High compression; may require 7-Zip on other systems."
msgstr "Высокая степень сжатия; на других системах может потребоваться 7-Zip."

#: src/nautilus_7zip/application.py:321
msgid "Widely compatible; AES-256 encryption may require 7-Zip."
msgstr ""
"Широкая совместимость; для шифрования AES-256 может потребоваться 7-Zip."

#: src/nautilus_7zip/application.py:327
msgid "Compression level"
msgstr "Уровень сжатия"

#: src/nautilus_7zip/application.py:329
msgid "Store (no compression)"
msgstr "Без сжатия"

#: src/nautilus_7zip/application.py:330
msgid "Fastest"
msgstr "Самое быстрое"

#: src/nautilus_7zip/application.py:331
msgid "Fast"
msgstr "Быстрое"

#: src/nautilus_7zip/application.py:332
msgid "Normal"
msgstr "Обычное"

#: src/nautilus_7zip/application.py:333
msgid "Maximum"
msgstr "Максимальное"

#: src/nautilus_7zip/application.py:334
msgid "Ultra"
msgstr "Ультра"

#: src/nautilus_7zip/application.py:344
msgid "Encryption"
msgstr "Шифрование"

#: src/nautilus_7zip/application.py:346
msgid "Password protection"
msgstr "Защита паролем"

#: src/nautilus_7zip/application.py:347 src/nautilus_7zip/application.py:626
msgid "Encrypts archive contents with AES-256."
msgstr "Шифрует содержимое архива с помощью AES-256."

#: src/nautilus_7zip/application.py:353
msgid "Password"
msgstr "Пароль"

#: src/nautilus_7zip/application.py:357
msgid "Confirm password"
msgstr "Подтвердите пароль"

#: src/nautilus_7zip/application.py:361
msgid "Encrypt file names"
msgstr "Шифровать имена файлов"

#: src/nautilus_7zip/application.py:362
msgid "Hides file names until the password is entered."
msgstr "Скрывает имена файлов до ввода пароля."

#: src/nautilus_7zip/application.py:370
msgid "Options"
msgstr "Параметры"

#: src/nautilus_7zip/application.py:372
msgid "Verify after creation"
msgstr "Проверить после создания"

#: src/nautilus_7zip/application.py:373
msgid "Tests archive integrity when compression finishes."
msgstr "Проверяет целостность архива после завершения сжатия."

#: src/nautilus_7zip/application.py:376
msgid "Advanced Options"
msgstr "Расширенные параметры"

#: src/nautilus_7zip/application.py:379
msgid "CPU threads"
msgstr "Потоки CPU"

#: src/nautilus_7zip/application.py:381
#, python-brace-format
msgid "Auto ({count})"
msgstr "Автоматически ({count})"

#: src/nautilus_7zip/application.py:384
msgid "Limits CPU usage. Auto uses available processors."
msgstr ""
"Ограничивает нагрузку на CPU. Автоматический режим использует доступные "
"потоки."

#: src/nautilus_7zip/application.py:387
msgid "Solid block"
msgstr "Непрерывный блок"

#: src/nautilus_7zip/application.py:389
msgid "Auto"
msgstr "Авто"

#: src/nautilus_7zip/application.py:389
msgid "Recommended"
msgstr "Рекомендуется"

#: src/nautilus_7zip/application.py:390
msgid "Non-solid"
msgstr "Без непрерывного сжатия"

#: src/nautilus_7zip/application.py:390
msgid "Independent extraction"
msgstr "Независимое извлечение"

#: src/nautilus_7zip/application.py:394
msgid "Fully solid"
msgstr "Полностью непрерывный"

#: src/nautilus_7zip/application.py:394
msgid "One block"
msgstr "Один блок"

#: src/nautilus_7zip/application.py:399
msgid "Controls how much data is grouped into each solid block."
msgstr "Определяет объём данных, объединяемых в один сплошной блок."

#: src/nautilus_7zip/application.py:402 src/nautilus_7zip/application.py:414
#: src/nautilus_7zip/application.py:424
msgid "Single archive"
msgstr "Один архив"

#: src/nautilus_7zip/application.py:409 src/nautilus_7zip/application.py:421
#: src/nautilus_7zip/application.py:431
msgid "Custom…"
msgstr "Другой размер…"

